{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omniscan-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "EventHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventHub"]
    }
  ]
}
