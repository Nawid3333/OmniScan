# Python / uv (".venv" without slash also matches the symlink builder worktrees use)
.venv
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.pyright/

# Data — never commit raws, outputs, models (copyright + size)
library/
work/
output/
samples/
models/
*.npz

# Secrets
.env
.env.*
secrets.env

# Builder agent logs
.builder/logs/

# Relay (Cloudflare Worker)
relay/node_modules/
relay/.wrangler/
relay/.dev.vars

# Web frontend
src/omniscan/web/frontend/node_modules/
src/omniscan/web/frontend/dist/
webui/node_modules/
webui/dist/

# Editors / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Local data root on Windows setups (library / work / output live here)
/data/
.mutate_backup/
.builder/*.log
